{
  "id": "page",
  "label": "Page",
  "repeatable": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID",
          "placeholder": "URL slug for the page"
        }
      },
      "title": {
        "type": "StructuredText",
        "config": {
          "label": "Title",
          "placeholder": "Title for the page",
          "single": "heading1",
          "allowTargetBlank": false
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "markdown": {
              "type": "SharedSlice"
            },
            "youtube": {
              "type": "SharedSlice"
            },
            "stats": {
              "type": "SharedSlice"
            },
            "testimonials": {
              "type": "SharedSlice"
            },
            "call_to_action": {
              "type": "SharedSlice"
            },
            "team_list": {
              "type": "SharedSlice"
            },
            "text_image_grid": {
              "type": "SharedSlice"
            },
            "faqs": {
              "type": "SharedSlice"
            },
            "body_text": {
              "type": "SharedSlice"
            },
            "articles": {
              "type": "SharedSlice"
            },
            "hero": {
              "type": "SharedSlice"
            }
          }
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "type": "Text",
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        }
      },
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        }
      },
      "meta_image": {
        "type": "Image",
        "config": {
          "label": "Meta Image",
          "constraint": {
            "width": 2400,
            "height": 1260
          },
          "thumbnails": []
        }
      },
      "schema": {
        "type": "Link",
        "config": {
          "label": "Schema",
          "select": "document",
          "customtypes": [
            "schema"
          ]
        }
      },
      "schemas": {
        "type": "Group",
        "config": {
          "label": "Schemas",
          "repeat": true,
          "fields": {
            "schema": {
              "type": "Link",
              "config": {
                "label": "Schema",
                "select": "document",
                "customtypes": [
                  "schema"
                ]
              }
            }
          }
        }
      }
    }
  },
  "status": true,
  "format": "page"
}